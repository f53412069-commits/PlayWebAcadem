# انسخ هذا الملف باسم .env واملأ القيم قبل تشغيل السيرفر

PORT=3000

# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول (JWT). لا تشاركه مع أحد.
# مثال لتوليد واحد: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=satartandnaw23fatmanjmitandwab

# اختياري: فعّله فقط إذا تبي تسجيل الدخول بجوجل يشتغل فعلياً
# سوي مشروع على Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=

# مسار ملف قاعدة البيانات (اختياري، افتراضي: codequest.db بجانب السيرفر)
DB_PATH=./codequest.db
